:root {
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  color: #f4f7fb;
  background: #07111f;
  font-synthesis: none;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-width: 320px;
  background:
    radial-gradient(circle at 80% 0%, rgba(0, 210, 170, 0.12), transparent 32rem),
    #07111f;
}

button {
  font: inherit;
  cursor: pointer;
}

.app {
  min-height: 100vh;
  padding-bottom: 82px;
}

.topbar {
  height: 72px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 6%;
  border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  background: rgba(7, 17, 31, 0.88);
  backdrop-filter: blur(14px);
}

.brand {
  display: flex;
  align-items: center;
  gap: 11px;
}

.brand-mark {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  background: linear-gradient(135deg, #19d6ad, #087d8c);
  color: #04131c;
  font-weight: 900;
  font-size: 22px;
}

.brand strong {
  display: block;
  font-size: 18px;
}

.brand span {
  display: block;
  margin-top: 1px;
  color: #7e91a8;
  font-size: 9px;
  letter-spacing: 2px;
  font-weight: 700;
}

.profile-button {
  width: 42px;
  height: 42px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  background: #101e30;
}

main {
  width: min(1180px, 88%);
  margin: auto;
}

.hero {
  min-height: 470px;
  display: grid;
  grid-template-columns: 1.25fr 0.75fr;
  gap: 40px;
  align-items: center;
  padding: 70px 0;
}

.eyebrow {
  color: #1ed8b0;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 2px;
}

.hero h1 {
  margin: 14px 0;
  font-size: clamp(46px, 7vw, 76px);
  line-height: 0.95;
  letter-spacing: -3px;
}

.hero p {
  max-width: 560px;
  color: #94a6bb;
  font-size: 17px;
  line-height: 1.7;
}

.hero-actions {
  display: flex;
  gap: 12px;
  margin-top: 28px;
  flex-wrap: wrap;
}

.primary-button,
.secondary-button {
  border: 0;
  border-radius: 12px;
  padding: 14px 20px;
  font-weight: 800;
}

.primary-button {
  color: #04131c;
  background: #20d8b0;
}

.secondary-button {
  color: #eef5fb;
  background: #122235;
  border: 1px solid rgba(255, 255, 255, 0.09);
}

.hero-card {
  min-height: 260px;
  padding: 30px;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  border: 1px solid rgba(30, 216, 176, 0.22);
  border-radius: 24px;
  background:
    linear-gradient(145deg, rgba(16, 52, 69, 0.8), rgba(8, 20, 34, 0.95));
  box-shadow: 0 25px 80px rgba(0, 0, 0, 0.25);
}

.hero-card > span:not(.live-dot) {
  color: #ff5b68;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 2px;
}

.live-dot {
  width: 9px;
  height: 9px;
  margin-bottom: 12px;
  border-radius: 50%;
  background: #ff5361;
  box-shadow: 0 0 15px rgba(255, 83, 97, 0.8);
}

.hero-card strong {
  margin-top: 12px;
  font-size: 27px;
}

.hero-card small {
  margin-top: 9px;
  color: #8ea2b8;
  line-height: 1.5;
}

.section {
  padding: 30px 0 50px;
}

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 20px;
  margin-bottom: 22px;
}

.section h2 {
  margin: 7px 0 0;
  font-size: 29px;
}

.text-button {
  border: 0;
  background: none;
  color: #1ed8b0;
  font-weight: 700;
}

.games-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 12px;
}

.game-card {
  min-height: 155px;
  padding: 18px;
  text-align: left;
  color: #f4f7fb;
  border: 1px solid rgba(255, 255, 255, 0.07);
  border-radius: 17px;
  background: #0d1b2c;
  transition: 0.2s ease;
}

.game-card:hover {
  transform: translateY(-3px);
  border-color: rgba(30, 216, 176, 0.4);
}

.game-icon {
  width: 48px;
  height: 48px;
  display: grid;
  place-items: center;
  margin-bottom: 22px;
  border-radius: 13px;
  color: #081722;
  background: #20d8b0;
  font-size: 11px;
  font-weight: 900;
}

.game-card strong {
  display: block;
  font-size: 14px;
}

.game-card span:not(.arrow) {
  display: block;
  margin-top: 5px;
  color: #72879e;
  font-size: 11px;
}

.arrow {
  float: right;
  color: #20d8b0;
  font-size: 22px;
}

.feature-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}

.feature-card {
  min-height: 260px;
  padding: 28px;
  border-radius: 22px;
  border: 1px solid rgba(255, 255, 255, 0.07);
}

.feature-card.tournament {
  background: linear-gradient(135deg, #162c2d, #0d1b2c);
}

.feature-card.live {
  background: linear-gradient(135deg, #2b2028, #0d1b2c);
}

.feature-icon {
  display: block;
  margin-bottom: 25px;
  font-size: 28px;
}

.feature-card h2 {
  margin-top: 8px;
}

.feature-card p {
  max-width: 440px;
  color: #8da0b5;
  line-height: 1.6;
}

.feature-card button {
  margin-top: 8px;
  padding: 0;
  border: 0;
  color: #20d8b0;
  background: none;
  font-weight: 800;
}

.bottom-nav {
  position: fixed;
  z-index: 10;
  left: 50%;
  bottom: 14px;
  transform: translateX(-50%);
  width: min(620px, 92%);
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  padding: 8px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 18px;
  background: rgba(10, 25, 40, 0.94);
  backdrop-filter: blur(18px);
  box-shadow: 0 15px 50px rgba(0, 0, 0, 0.35);
}

.bottom-nav button {
  border: 0;
  padding: 9px 3px;
  color: #71869d;
  background: none;
  font-size: 10px;
  font-weight: 700;
}

.bottom-nav button span {
  display: block;
  margin-bottom: 4px;
  font-size: 17px;
}

.bottom-nav button.active {
  color: #20d8b0;
}

@media (max-width: 850px) {
  .hero {
    grid-template-columns: 1fr;
    padding: 45px 0;
  }

  .hero-card {
    min-height: 210px;
  }

  .games-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 600px) {
  main {
    width: 92%;
  }

  .topbar {
    padding: 0 4%;
  }

  .hero h1 {
    font-size: 54px;
  }

  .feature-grid {
    grid-template-columns: 1fr;
  }

  .games-grid {
    grid-template-columns: 1fr 1fr;
  }

  .game-card {
    min-height: 135px;
    padding: 14px;
  }
}
